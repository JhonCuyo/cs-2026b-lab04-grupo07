tle": "Total Soles", "type": "string"}, "comision_fija": {"title": "Comision Fija", "type": "number"}, "pedidos": {"items": {"additionalProperties": true, "type": "object"}, "title": "Pedidos", "type": "array"}}, "required": ["puesto", "estado_filtro", "cantidad_pedidos", "total_soles", "comision_fija", "pedidos"], "title": "ResumenPuesto", "type": "object"}, "title": "Pedidos y totales por puesto"}, {"annotations": {"destructiveHint": false, "idempotentHint": true, "openWorldHint": false, "readOnlyHint": true}, "description": "Ejecuta la suite de pruebas (pytest) de San Camilo en Línea sobre tests/ y devuelve el resumen final. No modifica archivos.", "inputSchema": {"type": "object", "properties": {}, "title": "ejecutar_pruebasArguments"}, "name": "ejecutar_pruebas", "outputSchema": {"properties": {"result": {"title": "Result", "type": "string"}}, "required": ["result"], "title": "ejecutar_pruebasOutput", "type": "object"}, "title": "Ejecutar pruebas del proyecto"}, {"annotations": {"destructiveHint": false, "idempotentHint": false, "openWorldHint": false, "readOnlyHint": false}, "description": "Crea un archivo JSON nuevo en agentes/mcp/borradores/PEDIDO-NN.json con un pedido en estado BORRADOR.\nNunca sobrescribe ni elimina archivos existentes. cliente: 3-60 chars; puesto: A-01, A-02, A-03 o B-05; producto: 2-80 chars; cantidad: entero 1-50.", "inputSchema": {"type": "object", "properties": {"cliente": {"title": "Cliente", "type": "string"}, "puesto": {"title": "Puesto", "type": "string"}, "producto": {"title": "Producto", "type": "string"}, "cantidad": {"title": "Cantidad", "type": "integer"}}, "required": ["cliente", "puesto", "producto", "cantidad"], "title": "registrar_pedido_borradorArguments"}, "name": "registrar_pedido_borrador", "outputSchema": {"properties": {"result": {"title": "Result", "type": "string"}}, "required": ["result"], "title": "registrar_pedido_borradorOutput", "type": "object"}, "title": "Registrar pedido en borrador"}], "ttlMs": 0, "_meta"