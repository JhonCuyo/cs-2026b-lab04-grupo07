@startuml
set separator none
title Backend API - Dynamic

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Container_Boundary("SanCamiloenLínea.BackendAPI_boundary", "Backend API", $tags="") {
  Component(SanCamiloenLínea.BackendAPI.MóduloNotificaciones, "Módulo Notificaciones", $techn="Django app (notificaciones)", $descr="Gestiona el envío asíncrono de avisos a comerciantes mediante el puerto Notificador.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloCatálogo, "Módulo Catálogo", $techn="Django app (catalogo)", $descr="Gestiona puestos del mercado, publicación de productos y reserva de stock.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloPedidos, "Módulo Pedidos", $techn="Django app (pedidos)", $descr="Orquesta el carrito multipuesto, confirmación, ciclo de vida del pedido y asignación de entrega.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloPagos, "Módulo Pagos", $techn="Django app (pagos)", $descr="Procesa cobros desacoplados mediante el puerto PasarelaPago y su adaptador YapeAdapter.", $tags="", $link="")
}

Container(SanCamiloenLínea.PWASanCamilo, "PWA San Camilo", $techn="React + Service Worker", $descr="Aplicación web progresiva ligera optimizada para redes 3G y celulares de gama baja.", $tags="", $link="")
ContainerDb(SanCamiloenLínea.BasedeDatos, "Base de Datos", $techn="PostgreSQL 16", $descr="Almacena catálogo de puestos, pedidos multipuesto y pagos con esquemas aislados por módulo.", $tags="", $link="")
ContainerQueue(SanCamiloenLínea.ColayCaché, "Cola y Caché", $techn="Redis", $descr="Broker de mensajería para tareas asíncronas y caché de lecturas del catálogo.", $tags="", $link="")
System(PasarelaYapeAPI, "Pasarela Yape API", $descr="Procesa el cobro electrónico de los pedidos mediante billetera móvil.", $tags="", $link="")

Rel(SanCamiloenLínea.PWASanCamilo, SanCamiloenLínea.BackendAPI.MóduloPedidos, "1. POST /pedidos/{id}/pago (confirmarYPagar)", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BasedeDatos, "2. Busca el pedido multipuesto por ID", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloCatálogo, "3. Reserva stock por cada línea del pedido", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloPagos, "4. Solicita cobro del total calculado (puerto PasarelaPago)", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPagos, PasarelaYapeAPI, "5. Ejecuta cobro electrónico (cobrar total y celular)", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPagos, SanCamiloenLínea.BasedeDatos, "6. Registra transacción de pago aprobada", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BasedeDatos, "7. Actualiza estado del pedido a PAGADO", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloNotificaciones, "8. Solicita notificar nuevo pedido (puerto Notificador)", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloNotificaciones, SanCamiloenLínea.ColayCaché, "9. Encola mensaje asíncrono para WhatsApp por comerciante", $techn="Redis protocol", $tags="", $link="")

SHOW_LEGEND(true)
@enduml