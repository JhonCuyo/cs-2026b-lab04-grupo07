@startuml
set separator none
title San Camilo en Línea - Backend API - Components

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Container(SanCamiloenLínea.PWASanCamilo, "PWA San Camilo", $techn="React + Service Worker", $descr="Aplicación web progresiva ligera optimizada para redes 3G y celulares de gama baja.", $tags="", $link="")
ContainerDb(SanCamiloenLínea.BasedeDatos, "Base de Datos", $techn="PostgreSQL 16", $descr="Almacena catálogo de puestos, pedidos multipuesto y pagos con esquemas aislados por módulo.", $tags="", $link="")
ContainerQueue(SanCamiloenLínea.ColayCaché, "Cola y Caché", $techn="Redis", $descr="Broker de mensajería para tareas asíncronas y caché de lecturas del catálogo.", $tags="", $link="")
System(PasarelaYapeAPI, "Pasarela Yape API", $descr="Procesa el cobro electrónico de los pedidos mediante billetera móvil.", $tags="", $link="")

Container_Boundary("SanCamiloenLínea.BackendAPI_boundary", "Backend API", $tags="") {
  Component(SanCamiloenLínea.BackendAPI.MóduloNotificaciones, "Módulo Notificaciones", $techn="Django app (notificaciones)", $descr="Gestiona el envío asíncrono de avisos a comerciantes mediante el puerto Notificador.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloReportes, "Módulo Reportes", $techn="Django app (reportes)", $descr="Genera consultas y resúmenes de ventas por puesto en modo de solo lectura.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloCompartido, "Módulo Compartido", $techn="Python package (compartido)", $descr="Provee clases base de dominio, utilidades transversales y excepciones comunes.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloCatálogo, "Módulo Catálogo", $techn="Django app (catalogo)", $descr="Gestiona puestos del mercado, publicación de productos y reserva de stock.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloPedidos, "Módulo Pedidos", $techn="Django app (pedidos)", $descr="Orquesta el carrito multipuesto, confirmación, ciclo de vida del pedido y asignación de entrega.", $tags="", $link="")
  Component(SanCamiloenLínea.BackendAPI.MóduloPagos, "Módulo Pagos", $techn="Django app (pagos)", $descr="Procesa cobros desacoplados mediante el puerto PasarelaPago y su adaptador YapeAdapter.", $tags="", $link="")
}

Rel(SanCamiloenLínea.PWASanCamilo, SanCamiloenLínea.BackendAPI.MóduloCatálogo, "Consulta puestos y publica productos", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(SanCamiloenLínea.PWASanCamilo, SanCamiloenLínea.BackendAPI.MóduloPedidos, "Crea, confirma y actualiza pedidos multipuesto", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(SanCamiloenLínea.PWASanCamilo, SanCamiloenLínea.BackendAPI.MóduloReportes, "Consulta reportes de ventas por puesto", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloCatálogo, "Valida productos por puesto y reserva stock", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloPagos, "Solicita cobro mediante puerto PasarelaPago", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloNotificaciones, "Solicita aviso de nuevo pedido mediante puerto Notificador", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloReportes, SanCamiloenLínea.BackendAPI.MóduloPedidos, "Consulta pedidos históricos (solo lectura)", $techn="Llamada interna Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloCatálogo, SanCamiloenLínea.BackendAPI.MóduloCompartido, "Usa abstracciones base y utilidades", $techn="Importación Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BackendAPI.MóduloCompartido, "Usa abstracciones base y utilidades", $techn="Importación Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPagos, SanCamiloenLínea.BackendAPI.MóduloCompartido, "Usa abstracciones base y utilidades", $techn="Importación Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloNotificaciones, SanCamiloenLínea.BackendAPI.MóduloCompartido, "Usa abstracciones base y utilidades", $techn="Importación Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloReportes, SanCamiloenLínea.BackendAPI.MóduloCompartido, "Usa abstracciones base y utilidades", $techn="Importación Python", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloCatálogo, SanCamiloenLínea.BasedeDatos, "Lee y escribe productos y puestos", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloCatálogo, SanCamiloenLínea.ColayCaché, "Lee y actualiza caché de catálogo", $techn="Redis protocol", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPedidos, SanCamiloenLínea.BasedeDatos, "Lee y escribe pedidos multipuesto", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPagos, SanCamiloenLínea.BasedeDatos, "Registra transacciones de pago", $techn="SQL/TCP", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloPagos, PasarelaYapeAPI, "Ejecuta cobro electrónico mediante YapeAdapter", $techn="HTTPS/JSON", $tags="", $link="")
Rel(SanCamiloenLínea.BackendAPI.MóduloNotificaciones, SanCamiloenLínea.ColayCaché, "Encola tarea asíncrona de notificación", $techn="Redis protocol", $tags="", $link="")

SHOW_LEGEND(true)
@enduml